                    "on_tick",
                    "on_heal_player",
                    "on_player_spawn"
                  ],
                  "default": "on_input_action",
                  "serializationType": "enum-string",
                  "enumObject": {
                    "ON_CLICK": "on_click",
                    "ON_INPUT_ACTION": "on_input_action",
                    "ON_STATE_CHANGE": "on_state_change",
                    "ON_SPAWN": "on_spawn",
                    "ON_TWEEN_END": "on_tween_end",
