              },
              {
                "name": "Going to End",
                "type": "set_state",
                "jsonPayload": "{ \"state\": \"GoingToEnd\" }"
              },
              {
                "name": "Tween to Start",
                "type": "start_tween",
                "jsonPayload": "{\"type\":\"move_item\",\"end\":{\"x\":0,\"y\":-9,\"z\":0},\"relative\":true,\"interpolationType\":\"linear\",\"duration\":5}"
              },
              {
                "name": "Tween to End",
