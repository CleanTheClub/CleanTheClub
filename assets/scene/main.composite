                "jsonPayload": "{\"type\":\"move_item\",\"end\":{\"x\":0,\"y\":9,\"z\":0},\"relative\":true,\"interpolationType\":\"linear\",\"duration\":5}"
              }
            ]
          }
        },
        "770": {
          "json": {
            "id": 16,
            "value": [
              {
                "name": "Move here",
                "type": "move_player_here",
                "jsonPayload": "{}"
              },
              {
                "name": "Sit anim1",
                "type": "play_default_emote",
                "jsonPayload": "{\"emote\":\"sittingChair1\"}"
              },
              {
                "name": "Mark as taken",
                "type": "set_state",
                "jsonPayload": "{\"state\":\"Taken\"}"
              },
              {
                "name": "Mark as free",
                "type": "set_state",
                "jsonPayload": "{\"state\":\"Free\"}",
                "allowedInBasicView": true
              },
              {
                "name": "Sit Here",
                "type": "batch",
                "jsonPayload": "{\"actions\":[\"Move here\",\"Mark as taken\",\"Delay sit anim\",\"Random sit anim\"]}",
                "allowedInBasicView": true
              },
              {
                "name": "Sit anim2",
                "type": "play_default_emote",
                "jsonPayload": "{\"emote\":\"sittingChair2\"}"
              },
              {
                "name": "Random sit anim",
                "type": "random",
                "jsonPayload": "{\"actions\":[\"Sit anim1\",\"Sit anim2\"]}"
              },
              {
                "name": "Print text",
                "type": "show_text",
                "jsonPayload": "{\"text\":\"Seat is taken\",\"hideAfterSeconds\":2,\"font\":0,\"fontSize\":40,\"textAlign\":7}"
